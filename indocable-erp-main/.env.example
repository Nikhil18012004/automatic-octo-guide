# Copy this file to .env.local and fill in the values.
# (.env.local is gitignored. In Vercel, set these in Project → Settings → Environment Variables.)

# ── Supabase (required for the app) ─────────────────────────────────────────────
# Supabase → Settings → API → Project URL and the "anon / public" key.
# The anon key is public-by-design (browser client) and protected by Row-Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Store-access (door monitor) login — client-side test gate only, not real security ──
VITE_STORE_ACCESS_ID=store@example.com
VITE_STORE_ACCESS_PASSWORD=change-me

# ── Optional — only if you use: npm run db:apply-store-gate ──────────────────────
# Easier: use Supabase SQL Editor instead (see STORE_GATE_SETUP.md Step 1)
# Supabase → Settings → Database → Connection string → URI → paste below
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
